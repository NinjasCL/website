	var promise = Parse.Promise.as();

	// Comenzamos la importacion

	promise.then(function() {
		// Guardar todos los expositores
		var innerPromise = Parse.Promise.as();

		_.each(expositores, function(expositor){
			innerPromise = innerPromise.then(function(){
				return expositor.save().then(function(){
					console.log('Expositor Guardado');
				});
			});
		});

		return innerPromise;
	}).then(function(){
		// Guardar todos los temas

		var innerPromise = Parse.Promise.as();

		_.each(temas, function(tema){
			innerPromise = innerPromise.then(function(){
				return tema.save().then(function(){
					console.log('Tema Guardado');
				});
			});
		});

		return innerPromise;

	}).then(function(){
		// Asociar temas a expositor

		var innerPromise = Parse.Promise.as();

		_.each(expositores, function(expositor){
			var nombre = expositor.get('nombre');
			var temas = temasParaExpositor[nombre];

			expositor.set('temas', temas);

			innerPromise = innerPromise.then(function(){
				return expositor.save().then(function(){

					console.log('Temas asociados a Expositor');

					var innerPromise2 = Parse.Promise.as();

					_.each(temas, function(tema){
						tema.set('expositor', expositor);

						innerPromise2 = innerPromise2.then(function(){
							return tema.save().then(function(){
								console.log('Expositor Asociado a Tema');
							});
						});
					});

					return innerPromise2;
				});
			});
		});

		return innerPromise;

	}).then(function(){
		console.log('Todo OK');
	}, function(error){
		console.error(error.message);
	});
}
// Fin del Script de Importar
```

## 結論

Parse.com は、サーバーの保守やスケーリングに伴う頭痛に悩まされることなく、アプリケーションやプロトタイプを素早く作るうえで大きな助けになります。とはいえ、何事にも言えることですが、複雑なアプリケーションが抱える幅広いニーズとなると、Parse が提供するものを補完する外部サービスの利用が必要になるかもしれません。新しいプロジェクトで Parse.com を検討する際には、以下の点に留意してください：

- Parse の無料版には100万リクエストの制限があります。人気のアプリケーションなら簡単に超えてしまうので、超過分のコストを支払うか、必要に応じてプロフェッショナル版やエンタープライズ版に移行する覚悟が必要です。

- 現在のところ（実装は進められていますが）、開発環境から本番環境へアプリケーションを直接移行する方法はありません。そのためには、あるアプリケーションの情報を別の新しいアプリケーションへ移す必要がありますが、ACL を移行する方法はありません。考えられる解決策のひとつは、JavaScript でのインポートを利用することです。

- アナリティクスのデータはエクスポートできますが、手動でのみ可能です。そのデータに自動的にアクセスする API は（まだ）存在しません。アナリティクスの役割を果たせる外部サービスとしては、[Count.ly](http://count.ly/)、[Piwik](http://piwik.org/)、[Google Analytics](http://www.google.com/analytics/) などがあります。

- CodeCloud のコードはアップロードすると上書きされます。複数の人がそのコードで作業する場合は、Git を使うことをおすすめします。

- アプリケーションの Web 版を作るのに Javascript を使うと、アクセスキーが手に入る状態になります。データへのアクセスを制限する ACL を作成することが重要です。

- Parse.com は Facebook に買収されたので、もし人気が出れば、Parse を使ったアプリケーションが Facebook に買収される可能性も高くなります :) 。

