## Tecnologías

- Objective-C
- iOS 6
- Parse.com

```objectivec

#import "Item.h"
#import <Parse/PFObject+Subclass.h>

@implementation Item

@dynamic displayName;
@dynamic displayDescription;
@dynamic image;
@dynamic available;
@dynamic isAdultsOnly;
@dynamic categories;

+ (NSString *)parseClassName {
    return @"Item";
}
@end
```

```objectivec
#import <Parse/Parse.h>
#import "Item.h"

@interface Product : Item <PFSubclassing>
+ (NSString *)parseClassName;


// How much it costs
@property (strong) NSNumber * price;

// What this product is made of
// Array of Components
@property (strong) NSArray * components;

// What are the default ones
// Array of Components
@property (strong) NSArray * defaultComponents;

// If a component have a lesser price when used in an specific product
// Array of NSNumbers
// Must be in the same position as the Array of Components
// Later combine components and price correction in a NSDictionary for easier use
@property (strong) NSArray * priceCorrectionsForComponents;

@end
```
