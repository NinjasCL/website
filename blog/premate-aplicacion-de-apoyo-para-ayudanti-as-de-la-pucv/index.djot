```c
#import <Realm/Realm.h>
#import "JMPTChannel.h"

extern NSString * const kJMPTActivePremateState;
extern NSString * const kJMPTClosedPremateState;
extern NSString * const kJMPTAbortedPremateState;
extern NSString * const kJMPTDonePremateState;
extern NSString * const kJMPTDoneWithPeoplePremateState;

@interface JMPTPremate : RLMObject

@property (nonatomic) NSInteger number;
@property (nonatomic) NSString * displayName;
@property (nonatomic) NSString * code;

@property (nonatomic) NSString * startAt;
@property (nonatomic) double startAtUnix;

@property (nonatomic) NSString * endAt;
@property (nonatomic) double endAtUnix;

@property (nonatomic) NSString * timelimitAt;
@property (nonatomic) double  timelimitUnix;

@property (nonatomic) NSString * address;
@property (nonatomic) NSString * about;

@property (nonatomic) NSString * state;
@property (nonatomic) NSString * stateCode;

@property (nonatomic) NSString * timeCode;
@property (nonatomic) BOOL isUserConfirmed;

@property (nonatomic) NSString * uid;

@property (nonatomic) RLMArray<JMPTChannel> * channels;

#pragma mark -  Instance Methods

/*!
 * Confirm Current User in Premate
 * @return BFTask when the Confirmation is Done
 */
- (BFTask *) makeConfirmation;

- (BOOL) isNotDone;
@end

// This protocol enables typed collections. i.e.:
// RLMArray<JMPTPremate>
RLM_ARRAY_TYPE(JMPTPremate)
```

```c
#import "JMPTPremate.h"
#import "JMPTPremateUrls.h"
#import "JMPTUser.h"
#import "JMPTChannels.h"
#import "JMPTJSONResponseSerializerWithData.h"
#import "RLMObject+JSON.h"
#import "RLMObject+Copying.h"
#import <AFNetworking/AFNetworking.h>

@implementation JMPTPremate

NSString * const kJMPTActivePremateState = @"Active";
NSString * const kJMPTClosedPremateState = @"Closed";
NSString * const kJMPTAbortedPremateState = @"Aborted";
NSString * const kJMPTDonePremateState = @"Done";
NSString * const kJMPTDoneWithPeoplePremateState = @"DoneWithPeople";

// Specify default values for properties

+ (NSDictionary *)defaultPropertyValues
{
  return @{@"displayName" : @"(EMPTY)",
           @"number" : @0,
           @"code" : @"",
           @"about" : @"",
           @"startAt" : @"",
           @"startAtUnix" : @0,
           @"endAt" : @"",
           @"endAtUnix" : @0,
           @"timelimitAt" : @"",
           @"timelimitUnix" : @0,
           @"address" : @"",
           @"isUserConfirmed" : @YES,
           @"uid" : @"",
           @"state" : @"",
           @"stateCode" : @"",
           @"timeCode" : @""
           };
}

+ (NSString *) primaryKey {
  return @"number";
}



#pragma mark - Custom Setters
- (void) setStateCode:(NSString *)stateCode {

    NSLog(@"%@", stateCode);

    if (!([stateCode isEqualToString:kJMPTActivePremateState] ||
        [stateCode isEqualToString:kJMPTClosedPremateState] ||
        [stateCode isEqualToString:kJMPTAbortedPremateState] ||
        [stateCode isEqualToString:kJMPTDonePremateState] ||
        [stateCode isEqualToString:kJMPTDoneWithPeoplePremateState])) {

    _state = @"Finalizado";
    }

    if ([stateCode isEqualToString:kJMPTClosedPremateState]) {
        _state = @"SIN INSCRIPCIONES";
    }

    _stateCode = stateCode;
}

#pragma mark - Instance Methods
/*!
 * Confirm Current User in Premate
 * @return BFTask when the Confirmation is Done
 */
- (BFTask *) makeConfirmation {
  BFTaskCompletionSource * promise = [BFTaskCompletionSource taskCompletionSource];

  NSString * token  = [JMPTUser current].token;

  NSString * confirmationUrl = [JMPTPremateUrls confirmPremateForToken:token andPremate:self];


  [[UIApplication sharedApplication] setNetworkActivityIndicatorVisible:YES];

  // Request Manager
  AFHTTPRequestOperationManager * manager = [AFHTTPRequestOperationManager manager];

  manager.requestSerializer = [AFJSONRequestSerializer serializer];

  manager.responseSerializer = [JMPTJSONResponseSerializerWithData serializer];

  // Send the Request
  [manager POST:confirmationUrl parameters:@{} success:^(AFHTTPRequestOperation *operation, id responseObject) {

    [promise setResult:responseObject];

  } failure:^(AFHTTPRequestOperation *operation, NSError *error) {
    [promise setError:error];
  }];

  // Register the channels
  [[promise.task continueWithSuccessBlock:^id(BFTask *task) {

    NSArray * channels = task.result[@"result"][@"data"][@"channels"];

    NSLog(@"Subscribing to Channels %@", channels);

    [JMPTChannels subscribeToChannels:channels];


      // Should put this on a model or helper

    return task;

  }] continueWithBlock:^id(BFTask *task) {
    [[UIApplication sharedApplication] setNetworkActivityIndicatorVisible:NO];
    return task;
  }];

  return promise.task;
}

- (BOOL) isNotDone {
    return ([self.stateCode isEqualToString:kJMPTActivePremateState] ||
            [self.stateCode isEqualToString:kJMPTClosedPremateState]);
}

@end
```

