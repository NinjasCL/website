        # Pierde contra Tijera y Lagarto
        elif jugador2.eleccion == 3 or jugador2.eleccion == 4:
            jugador2.sumarPunto()
            jugador1.sumarDerrota()

            if jugador2.eleccion == 3:
                mensaje = "Tijera Corta Papel"
